# apply-agent .env template. Copy to .env and fill in. NEVER COMMIT .env.
#
# Locked LLM choice: Gemini only. Do not add OPENAI_API_KEY, ANTHROPIC_API_KEY,
# or any other provider — the project is constrained to a $0/mo runtime cost.

# --- Gemini (free tier, https://aistudio.google.com/apikey) ---------------
# Required for resume tailoring, Tier-2 browser driving, and email classification.
# Phase 0 boots without it (with a warning).
GEMINI_API_KEY=

# --- Telegram (BotFather + getUpdates) ------------------------------------
# Required for HITL approval. Phase 0 supports --no-telegram.
# 1. DM @BotFather on Telegram, send /newbot, copy the token below.
# 2. Send any message to your new bot from your account.
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":"id".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Inbox (imap_tools-compatible IMAP server) ----------------------------
# Required for Phase 3 (account auto-signup + response monitoring).
# Use a dedicated email address for job applications — do NOT reuse your main
# personal email. The agent will read INBOX, mark mail Seen, and trigger
# Telegram alerts on interview/recruiter/offer responses.
#
# Common providers:
#   GMX           imap.gmx.com           port 993, SSL
#   Outlook.com   outlook.office365.com  port 993, SSL
#   Gmail         imap.gmail.com         port 993, SSL  (requires app password)
#   Proton        imap.proton.me         port 1143      (requires Proton Bridge)
#
# An app password is strongly recommended; enable 2FA on the account first.
APPLY_EMAIL_USER=
APPLY_EMAIL_PASSWORD=
APPLY_EMAIL_IMAP_HOST=imap.gmx.com
APPLY_EMAIL_IMAP_PORT=993

# --- Resume source directory ----------------------------------------------
# Path to a directory containing one subfolder per role variant, each holding
# a `*.md` resume. The selector cosine-ranks within whichever folder matches
# the JD. Default: ./resumes/ inside the repo.
#
# Example layout:
#   resumes/master/Resume_v1.md
#   resumes/staff-engineer/Resume_v1.md
#   resumes/engineering-manager/Resume_v1.md
RESUME_SOURCE_DIR=./resumes
